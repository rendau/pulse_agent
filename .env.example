# пример окружения pulse_agent (весь env в проде — в kusec, app pulse)
LOG_LEVEL=info
SYSTEM_HTTP_PORT=3013
HTTP_PORT=9092

# ключи систем-клиентов: имя:ключ через запятую
API_KEYS=dev:devkey
# ключ разработчика: /debug/* и /v1/*
DEBUG_TOKEN=devdebug
# кому можно запускать прогон эталонов (/v1/eval)
EVAL_CLIENTS=dev

LLM_PROVIDER=openai
LLM_MODEL=gpt-6-sol
LLM_REASONING_EFFORT=medium
OPENAI_API_KEY=

PULSE_MCP_URL=http://localhost:9091/mcp
PULSE_MCP_TOKEN=devtoken

AGENT_MAX_TOOL_CALLS=20
AGENT_TIMEOUT=5m
HISTORY_MAX_TURNS=10
HISTORY_TTL=1h
CHART_THEME=dark
